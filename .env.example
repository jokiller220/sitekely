# Connexion PostgreSQL Supabase côté serveur uniquement.
# Ne jamais exposer ces valeurs dans le navigateur ou les commiter.
SUPABASE_DB_DSN="pgsql:host=db.PROJECT_REF.supabase.co;port=5432;dbname=postgres;sslmode=require"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="replace-with-a-rotated-secret"

# Informations publiques utiles pour une future intégration Storage/Auth.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="replace-with-project-anon-key"
